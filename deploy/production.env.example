NODE_ENV=production
APP_NAME=lingcoo-app-starter
APP_VERSION=replace-with-git-sha
CORS_ORIGIN=https://frame.lingcoo.com
API_DOCS_ENABLED=false

POSTGRES_DB=lingcoo_app
POSTGRES_USER=lingcoo_app
POSTGRES_PASSWORD=replace-with-a-random-value
DATABASE_URL=postgres://lingcoo_app:replace-with-a-random-value@postgres:5432/lingcoo_app

LINGCOO_APP_IMAGE=replace-with-acr-image:git-sha
HTTP_PORT=18093
CADDY_SITE_ADDRESS=:80
